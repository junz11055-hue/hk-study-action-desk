# 可选：公开托管 Demo 使用 hosted；省略时保留本地邀请码与联调路径。
# DEMO_MODE=hosted

# 本地合成演示专用；请使用高熵值，不要使用 NEXT_PUBLIC_ 前缀。
DEMO_INVITE_CODE=replace-with-a-high-entropy-local-demo-code
# 可选 ISO 8601 失效时间；格式无效时会失败关闭。
# DEMO_INVITE_EXPIRES_AT=2026-09-08T23:59:59+08:00
DEMO_INVITE_MAX_USES=25
DEMO_SESSION_TTL_SECONDS=7200

# 本阶段只在本机 HTTP 体验。未来 HTTPS 环境必须显式改为 true 并重新验收。
DEMO_COOKIE_SECURE=false
