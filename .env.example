# 本地演示服务
RUNTIME_MODE=synthetic
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
# 留空时，应用每次启动会生成一个高熵本地邀请码并打印在终端。
DEMO_INVITE_CODES=
DEMO_INVITE_MAX_USES=25
SESSION_TTL_MINUTES=240

# 真实模型：密钥只存在服务端，绝不能写进 public/ 或提交到版本库
DEEPSEEK_API_KEY=
# 当前仅允许 deepseek-v4-flash 或 deepseek-v4-pro；本地 MVP 默认使用 flash。
DEEPSEEK_MODEL=deepseek-v4-flash
# Step 5 锁定 DeepSeek 官方 HTTPS 根主机，避免把 Bearer Key 发送到任意地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_MS=90000
MODEL_MAX_RETRIES=2
MODEL_PROCESS_BUDGET=100

# 无密钥或模型暂时不可用时，允许回退到明确标记的预置合成分析
ALLOW_PRESET_FALLBACK=true
